        "epub_member": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "epub_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "location_scope": {
          "enum": [
            "block",
            "item",
            "section",
            "edition",
            "unknown"
          ]
