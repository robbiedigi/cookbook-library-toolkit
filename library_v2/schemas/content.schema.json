        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "entity",
        "id"
      ],
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "edition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "asset_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "book": {
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "enum": [
            "pdf",
            "epub",
            "image",
            "other",
            "unknown"
          ]
