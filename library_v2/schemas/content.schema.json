                "type": "string",
                "minLength": 1
              },
              "optional": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "variant_scope": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "presence_basis": {
                "type": "string",
                "minLength": 1
