{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookbook.invalid/contracts/get_recipes.input.schema.json",
  "type": "object",
  "properties": {
    "recipe_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 20
    },
    "include_dependencies": {
      "type": "boolean",
      "default": true
    },
    "cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "recipe_ids"
  ],
  "additionalProperties": false
}
