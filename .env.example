# Optional hosted HTTP/MCP configuration; this file is not automatically loaded.
# Local CLI and stdio demo need no account, API key or environment variables.
COOKBOOK_V2_DB=/absolute/path/to/data/demo/library.sqlite
COOKBOOK_CURSOR_SECRET=replace-with-at-least-32-random-bytes
COOKBOOK_MCP_URL=https://your-host.example/mcp
COOKBOOK_OAUTH_ISSUER=https://your-identity-provider.example/
COOKBOOK_OAUTH_JWKS=https://your-identity-provider.example/.well-known/jwks.json
COOKBOOK_OAUTH_SUBJECT=your-exact-user-subject
COOKBOOK_OAUTH_ADDITIONAL_SUBJECTS=[]
PORT=8767
