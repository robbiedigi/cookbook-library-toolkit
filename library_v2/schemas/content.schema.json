            "role": {
              "enum": [
                "primary",
                "supporting",
                "unknown"
              ]
            },
            "optional": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "variant_scope": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
